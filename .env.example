# ========================================
# Lake Road PTA School - Environment Variables
# ========================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Update the values with your actual credentials
# 3. Never commit the .env file to version control
#
# Example:
#   cp .env.example .env  (Linux/Mac)
#   copy .env.example .env  (Windows)
#
# ========================================

# ========================================
# Django Settings
# ========================================

# Secret key for cryptographic signing
# Generate a new one for production: https://djecrety.ir/
SECRET_KEY=your-secret-key-here-change-in-production

# Debug mode (True for development, False for production)
# SECURITY WARNING: Never set DEBUG=True in production!
DEBUG=True

# Allowed hosts (comma-separated list)
# Example: yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ========================================
# Database Configuration (PostgreSQL)
# ========================================

# Database engine (don't change this)
DB_ENGINE=django.db.backends.postgresql

# Database name
DB_NAME=lakeroad_school

# Database username
DB_USER=postgres

# Database password (CHANGE THIS!)
DB_PASSWORD=your_postgres_password_here

# Database host (localhost for local development)
DB_HOST=localhost

# Database port (default PostgreSQL port)
DB_PORT=5432

# ========================================
# Optional Settings (uncomment to use)
# ========================================

# Email Configuration (for contact form, notifications)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# AWS S3 Configuration (for media files in production)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1

# Social Media Links
# FACEBOOK_URL=https://facebook.com/lrptas/
# TWITTER_URL=
# INSTAGRAM_URL=

# Google Analytics
# GA_TRACKING_ID=

# ========================================
# Production Settings Example
# ========================================
#
# For production, create a .env file with:
#
# SECRET_KEY=<generate-a-strong-random-key>
# DEBUG=False
# ALLOWED_HOSTS=lrptas.ac.zm,www.lrptas.ac.zm
# DB_NAME=lakeroad_school_dev
# DB_USER=lrptas_user
# DB_PASSWORD=<strong-database-password>
# DB_HOST=your-db-host.com
# DB_PORT=5432
#
# ========================================
